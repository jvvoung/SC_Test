<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SKCTPractice.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#F6F7F9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#24262B" />
      <Setter Property="BorderBrush" Value="#D9DDE4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#EB1744" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#EB1744" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D9DDE4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#4A4F58" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
