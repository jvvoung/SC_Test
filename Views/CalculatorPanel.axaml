<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SKCTPractice.Views.CalculatorPanel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="Button.calc-button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.equals-button">
      <Setter Property="Background" Value="#EB1744" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#EB1744" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card" Padding="8,7,8,8">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
      <Grid RowDefinitions="Auto,Auto">
        <TextBlock Text="계산기" Classes="section-title" />
        <TextBlock x:Name="ExpressionText" Grid.Row="1" Text="" Height="20" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Right" Foreground="#737985" FontSize="11" />
      </Grid>
      <TextBlock x:Name="DisplayText" Grid.Row="1" Text="0" FontSize="24" FontWeight="SemiBold"
                 HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="4,0,4,2" />

      <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" RowDefinitions="*,*,*,*,*"
            ColumnSpacing="3" RowSpacing="3" MinHeight="222">
        <Button Grid.Row="0" Grid.Column="0" Content="C" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="0" Grid.Column="1" Content="←" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="0" Grid.Column="2" Content="NEG" Classes="calc-button" FontSize="12" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="0" Grid.Column="3" Content="÷" Classes="calc-button" Click="OnCalculatorButtonClick" />

        <Button Grid.Row="1" Grid.Column="0" Content="7" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="1" Grid.Column="1" Content="8" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="1" Grid.Column="2" Content="9" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="1" Grid.Column="3" Content="×" Classes="calc-button" Click="OnCalculatorButtonClick" />

        <Button Grid.Row="2" Grid.Column="0" Content="4" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="2" Grid.Column="1" Content="5" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="2" Grid.Column="2" Content="6" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="2" Grid.Column="3" Content="-" Classes="calc-button" Click="OnCalculatorButtonClick" />

        <Button Grid.Row="3" Grid.Column="0" Content="1" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="3" Grid.Column="1" Content="2" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="3" Grid.Column="2" Content="3" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="3" Grid.Column="3" Content="+" Classes="calc-button" Click="OnCalculatorButtonClick" />

        <Button Grid.Row="4" Grid.Column="0" Content="0" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="4" Grid.Column="1" Content="00" Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="4" Grid.Column="2" Content="." Classes="calc-button" Click="OnCalculatorButtonClick" />
        <Button Grid.Row="4" Grid.Column="3" Content="=" Classes="calc-button equals-button" Click="OnCalculatorButtonClick" />
      </Grid>
    </Grid>
  </Border>
</UserControl>
