<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:SKCTPractice.Views"
        x:Class="SKCTPractice.MainWindow"
        Title="SKCT Practice"
        Width="410" Height="950"
        MinWidth="350" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="Manual">
  <Window.Styles>
    <Style Selector="GridSplitter.tool-splitter">
      <Setter Property="Background" Value="#D8DCE3" />
    </Style>
    <Style Selector="GridSplitter.tool-splitter:pointerover">
      <Setter Property="Background" Value="#9DA3AE" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="46,*">
    <Border Grid.Row="0" Background="White" BorderBrush="#D9DDE4" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" Margin="12,0">
        <Border Width="5" Height="20" CornerRadius="3" Background="#EB1744" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="SKCT Practice" Margin="9,0,0,0"
                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="160,*" ColumnSpacing="7" Margin="7">
      <views:QuestionPanel x:Name="QuestionPanel" Grid.Column="0" />
      <Grid Grid.Column="1" RowDefinitions="Auto,3*,7,4*">
        <views:TimerPanel Grid.Row="0" Margin="0,0,0,7" />
        <views:MemoDrawingPanel Grid.Row="1" MinHeight="160" Margin="0,0,0,3" />
        <GridSplitter Grid.Row="2"
                      Classes="tool-splitter"
                      Height="7"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNorthSouth" />
        <views:CalculatorPanel Grid.Row="3" MinHeight="295" Margin="0,3,0,0" />
      </Grid>
    </Grid>
  </Grid>
</Window>
